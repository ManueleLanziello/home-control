# Porta HTTP locale di Home Control. Pond-Control usa una porta separata.
HOME_CONTROL_PORT=3001
# Host HTTP. 0.0.0.0 permette accesso LAN; localhost continua a funzionare.
HOME_CONTROL_HOST=0.0.0.0
WT200_LAN_IP=
WT200_LOCAL_KEY=
# Endpoint di Pond-Control per la camera C2 condivisa. Home non usa credenziali Tapo per C2.
POND_CONTROL_URL=http://127.0.0.1:3000
# Credenziali Tapo locali, usate solo dalle camere C1/C3 possedute da Home.
TAPO_USERNAME=
TAPO_PASSWORD=
